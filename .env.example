# CFO Copilot on a Budget - Environment Configuration Template
# Copy this file to .env and customize. Do NOT commit real secrets.

# Application Settings
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Database (PostgreSQL or SQLite fallback for self-contained testing)
DATABASE_URL=sqlite:///./cfo_copilot.db
# DATABASE_URL=postgresql://cfo_user:cfo_pass@localhost:5432/cfo_copilot

# Inference Engine (Local OpenAI-compatible server e.g. llama.cpp / vLLM / Ollama)
INFERENCE_API_BASE=http://localhost:8080/v1
INFERENCE_MODEL=openai/qwen2.5-3b-instruct
INFERENCE_API_KEY=not-needed-for-local
INFERENCE_TIMEOUT_SECONDS=30
MAX_CONTEXT_TOKENS=4096
DROP2_MAX_CONTEXT_TOKENS=8192

# Multi-Tenant Configuration
TENANT_DEFAULT=tenant_a
ALLOWED_TENANTS=tenant_a,tenant_b

# Serving & Concurrency Limits
MAX_CONCURRENT_SESSIONS=16
REQUEST_QUEUE_TIMEOUT_SECONDS=10
RATE_LIMIT_RPS=20
