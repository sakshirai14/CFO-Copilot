# CFO Copilot on a Budget - Environment Configuration Template
# Copy this file to .env or run scripts/bootstrap_env.sh to generate secure random passwords.
# NEVER commit real credentials to git.

# Application Settings
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Database Settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_DB=cfo_copilot
POSTGRES_TEST_DB=cfo_copilot_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_super_secret_postgres_pass

# Three Segregated Database Roles (Foundation Lock 6)
DB_OWNER_USER=cfo_owner
DB_OWNER_PASSWORD=change_me_owner_password

DB_APP_RW_USER=app_rw
DB_APP_RW_PASSWORD=change_me_rw_password

DB_APP_RO_USER=app_ro
DB_APP_RO_PASSWORD=change_me_ro_password

# Multi-Tenant Configuration
TENANTS=acme,borealis
DEFAULT_TENANT=acme

# Serving & Concurrency Limits
MAX_CONCURRENT_SESSIONS=16
REQUEST_QUEUE_TIMEOUT_SECONDS=10
RATE_LIMIT_RPS=20

# Local LLM Serving Engine (Zero-Hosted API rule)
INFERENCE_API_BASE=http://localhost:8080/v1
INFERENCE_MODEL=openai/qwen2.5-3b-instruct
INFERENCE_API_KEY=not-needed-for-local
INFERENCE_TIMEOUT_SECONDS=30
MAX_CONTEXT_TOKENS=4096
DROP2_MAX_CONTEXT_TOKENS=8192
